# /etc/spanwatch/spanwatch.env — extra args for "spanwatch serve"
# Also log mDNS + LLMNR, keep 100 sessions:
#SPANWATCH_ARGS=--dns-ports 53,5353,5355 --keep 100
# Accept a tailnet Host header (pair with a --listen override via systemctl edit):
#SPANWATCH_ARGS=--allow-host your-host.your-tailnet.ts.net
# Hostname overrides are read from /etc/spanwatch/hosts (hosts-file format) if present.
# Use a different file:
#SPANWATCH_ARGS=--hosts-file /etc/spanwatch/my-hosts
# Turn off daily threat-feed downloads:
#SPANWATCH_ARGS=--no-feeds
# AbuseIPDB key goes in /etc/spanwatch/abuseipdb.key (root, 0600), not here.
# Pull DHCP leases, device names and blocked queries from Pi-hole v6
# (app password in /etc/spanwatch/pihole.key):
#SPANWATCH_ARGS=--pihole-url http://172.30.250.2
