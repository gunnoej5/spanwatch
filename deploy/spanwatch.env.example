# /etc/spanwatch/spanwatch.env — extra args for "spanwatch serve"
# Also log mDNS + LLMNR, keep 100 sessions:
#SPANWATCH_ARGS=--dns-ports 53,5353,5355 --keep 100
# Accept a tailnet Host header (pair with a --listen override via systemctl edit):
#SPANWATCH_ARGS=--allow-host fishtank.your-tailnet.ts.net
